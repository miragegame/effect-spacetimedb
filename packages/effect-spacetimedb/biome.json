{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 80
  },
  "files": {
    "includes": [
      "**",
      "!.tmp",
      "!examples/publishable-module/generated-client",
      "!examples/publishable-module/generated-client/**",
      "!examples/idc-pair/sender/src/remote",
      "!examples/idc-pair/sender/src/remote/**",
      "!test/fixtures/idc/remote",
      "!test/fixtures/idc/remote/**"
    ]
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "linter": {
      "enabled": false
    },
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  }
}
