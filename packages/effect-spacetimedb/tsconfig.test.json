{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "declarationDir": ".tmp/test-dist-types",
    "outDir": ".tmp/test-dist-types",
    "tsBuildInfoFile": "dist-types/tsconfig.test.tsbuildinfo",
    "incremental": true,
    "noEmit": false
  },
  "include": [
    "src/**/*.ts",
    "examples/cache-policy-fixture/**/*.ts",
    "examples/mounted-module/**/*.ts",
    "examples/environment-fixture/**/*.ts",
    "examples/failure-fixture/**/*.ts",
    "examples/invalid-contract-fixture/**/*.ts",
    "examples/idc-pair/**/*.ts",
    "examples/migration-fixture/**/*.ts",
    "examples/publishable-module/generated-client/*.d.ts",
    "examples/publishable-module/src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vitest*.ts"
  ],
  "exclude": ["dist-types", ".tmp/test-dist-types", "**/dist-types"]
}
