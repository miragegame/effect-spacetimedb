# Patch notes for spacetimedb@2.16.1:
# - Preserve branded primitives on input to Prettify and native builder
#   inference while keeping generic rows spreadable.
# - Upstream TableCache still compares object-backed range operands with raw
#   JavaScript ordering; normalize every supported native scalar first.
# - Upstream server index uniqueness checks use subset membership, causing a
#   prefix index of a composite unique constraint to lose its range methods;
#   require exact column-set equality.
# - Every disposition was re-verified against the published 2.16.1
#   tarball: every transform below matched the unpatched upstream text, so
#   each defect is still present. Bun patches apply only to workspace
#   installs; a published npm consumer does not receive these fixes
#   automatically.
# - Regenerate this patch for each SpacetimeDB version bump.

diff --git a/dist/index.browser.mjs b/dist/index.browser.mjs
index ac4bea69c9e185b3b242a40d7f368858f7ac0179..b7e021ed5becbc2c0aaeb5af28e6aa2d64fbd885 100644
--- a/dist/index.browser.mjs
+++ b/dist/index.browser.mjs
@@ -4652,9 +4652,31 @@ var EventEmitter = class {
 };
 
 // src/sdk/table_cache.ts
+var tableCacheComparableBigIntKeys = [
+  "__connection_id__",
+  "__identity__",
+  "__time_duration_micros__",
+  "__timestamp_micros_since_unix_epoch__",
+  "__uuid__"
+];
+var toTableCacheComparableValue = (value) => {
+  if (value instanceof Uint8Array) {
+    return Array.from(value, (byte) => byte.toString(16).padStart(2, "0")).join("");
+  }
+  if (value && typeof value === "object") {
+    for (const key of tableCacheComparableBigIntKeys) {
+      const candidate = value[key];
+      if (typeof candidate === "bigint") return candidate;
+    }
+    if (typeof value.toHexString === "function") return value.toHexString();
+  }
+  return value;
+};
 var scalarCompare = (x, y) => {
-  if (x === y) return 0;
-  return x < y ? -1 : 1;
+  const comparableX = toTableCacheComparableValue(x);
+  const comparableY = toTableCacheComparableValue(y);
+  if (comparableX === comparableY) return 0;
+  return comparableX < comparableY ? -1 : 1;
 };
 var isRange = (arg) => arg && typeof arg === "object" && "from" in arg && "to" in arg;
 var inRange = (value, range) => {
